# Terraform
# Le fichier .terraform.lock.hcl est suivi : il fige les versions des providers.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Variables propres à un poste : seuls les exemples sont suivis.
*.tfvars
*.tfvars.json
!*.tfvars.example
backend.hcl
# Paramètres d'environnement, sans secret : suivis par Git.
!terraform/envs/*/*.auto.tfvars
# Les modules ne figent pas leurs providers : la configuration appelante le fait.
terraform/modules/**/.terraform.lock.hcl

# Ansible
*.retry
.vault-pass*
ansible/inventories/**/generated/

# Kubernetes
kubeconfig
*.kubeconfig

# Secrets en clair : seuls les fichiers chiffrés par SOPS sont suivis.
*.dec.yaml
*.dec.yml
.env
.env.*
!.env.example

# Python (Ansible, Molecule)
.venv/
__pycache__/
*.pyc

# Éditeurs et système
.idea/
.vscode/
*.swp
.DS_Store
