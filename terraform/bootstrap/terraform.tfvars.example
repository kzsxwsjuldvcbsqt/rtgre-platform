# Copier en terraform.tfvars, qui n'est pas suivi par Git, puis remplir.
tenancy_ocid            = "ocid1.tenancy.oc1..<identifiant>"
region                  = "eu-paris-1"
oci_profile             = "DEFAULT"
project                 = "rtgre-platform"
environment             = "prod"
compartment_description = "Ressources de la plateforme qui héberge rtgre.fr."
monthly_budget_amount   = 1
first_spend_threshold   = 0.01
outage_alert_recipients = ["<adresse prévenue des pannes>"]
budget_alert_recipients = ["alertes@example.com"]
github_oidc_subject_prefix = "repo:<propriétaire>@<id>/rtgre-platform@<id>"
github_apply_environment   = "production"
