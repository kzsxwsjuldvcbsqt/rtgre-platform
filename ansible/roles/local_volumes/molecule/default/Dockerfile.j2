# Épinglée par empreinte : le pilote Docker de Molecule refuse une empreinte dans le champ image.
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289

ENV DEBIAN_FRONTEND=noninteractive

# python3 pour Ansible ; le rôle ne gère que des dossiers, sans service.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 sudo \
    && rm -rf /var/lib/apt/lists/*

CMD ["sleep", "infinity"]
