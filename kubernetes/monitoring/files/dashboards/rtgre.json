    {
      "type": "stat",
      "title": "Requêtes servies sur 24 heures",
      "description": "Lignes du journal de nginx : pages, feuilles de style, scripts. Les sondes n'y figurent pas.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"rtgre\", container=\"nginx\"} [24h]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
