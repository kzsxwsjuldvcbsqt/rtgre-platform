        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 11
    },
    {
      "type": "stat",
      "title": "Réseaux distincts sur 24 heures",
      "description": "Nombre approché de visiteurs : le journal ne garde que le réseau de chacun (ADR 0014).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (network) (count_over_time({namespace=\"rtgre\", container=\"nginx\"} | pattern \"<_> <network> <_>\" [24h])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
